NATIONKEY", "comment": null}, "C_PHONE": {"type": "TEXT", "index": 5, "name": "C_PHONE", "comment": null}, "C_ACCTBAL": {"type": "NUMBER", "index": 6, "name": "C_ACCTBAL", "comment": null}, "C_MKTSEGMENT": {"type": "TEXT", "index": 7, "name": "C_MKTSEGMENT", "comment": null}, "C_COMMENT": {"type": "TEXT", "index": 8, "name": "C_COMMENT", "comment": null}, "UPDATED_AT": {"type": "TIMESTAMP_NTZ", "index": 9, "name": "UPDATED_AT", "comment": null}}, "stats": {"bytes": {"id": "bytes", "label": "Approximate Size", "value": 10793472, "include": true, "description": "Approximate size of the table as reported by Snowflake"}, "last_modified": {"id": "last_modified", "label": "Last Modified", "value": "2026-11-03 03:24UTC", "include": true, "description": "The timestamp for last update/change"}, "row_count": {"id": "row_count", "label": "Row Count", "value": 150000, "include": true, "description": "An approximate count of rows in this table"}, "has_stats": {"id": "has_stats", "label": "Has Stats?", "value": true, "include": false, "description": "Indicates whether there are statistics for this table"}}, "unique_id": "source.retail_project.retail.customers"}, "source.retail_project.retail.regions": {"metadata": {"type": "BASE TABLE", "schema": "RAW", "name": "REGIONS", "database": "RETAIL_DBT", "comment": null, "owner": "ACCOUNTADMIN"}, "columns": {"R_REGIONKEY": {"type": "NUMBER", "index": 1, "name": "R_REGIONKEY", "comment": null}, "R_NAME": {"type": "TEXT", "index": 2, "name": "R_NAME", "comment": null}, "R_COMMENT": {"type": "TEXT", "index": 3, "name": "R_COMMENT", "comment": null}}, "stats": {"bytes": {"id": "bytes", "label": "Approximate Size", "value": 1536, "include": true, "description": "Approximate size of the table as reported by Snowflake"}, "last_modified": {"id": "last_modified", "label": "Last Modified", "value": "2026-11-03 03:24UTC", "include": true, "description": "The timestamp for last update/change"}, "row_count": {"id": "row_count", "label": "Row Count",