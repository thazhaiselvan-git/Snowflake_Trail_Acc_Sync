key as unique_field,\n    count(*) as n_records\n\nfrom RETAIL_DBT.DEV.stg_customers\nwhere customer_key is not null\ngroup by customer_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.330353Z", "completed_at": "2026-11-03T06:08:44.341958Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.348118Z", "completed_at": "2026-11-03T06:08:44.348123Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.06378412246704102, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.dim_customers", "compiled": true, "compiled_code": "\n\nselect\n    c.customer_key,\n    c.customer_name,\n    c.market_segment,\n    c.account_balance,\n    n.nation_name,\n    n.region_name,\n    rm.manager_name as region_manager\nfrom RETAIL_DBT.DEV.stg_customers c\nleft join RETAIL_DBT.DEV.stg_nations n\n    on c.nation_key = n.nation_key\nleft join RETAIL_DBT.DEV.region_managers rm\n    on n.region_name = rm.region_name", "relation_name": "RETAIL_DBT.DEV.dim_customers", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.360032Z", "completed_at": "2026-11-03T06:08:44.393272Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.412909Z", "completed_at": "2026-11-03T06:08:44.412915Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.06198835372924805, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.dt_daily_revenue", "compiled": true, "compiled_code": "-- Snowflake dynamic table: Snowflake refreshes it on its own within target_lag.\n-- refresh_mode FULL avoids needing change tracking on the RAW tables (DBT_ROLE doesn't own them).\n\n\nselect\n    order_date,\n    count(*)         as orders,\n    sum(total_price) as gross_revenue\nfrom RETAIL_DBT.DEV.stg_orders\ngroup by order_date", "relation_name": "RETAIL_DBT.DEV.dt_daily_revenue", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.364417Z", "completed_at": "2026-11-03T06:08:44.400685Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.414363Z", "completed_at": "2026-11-03T06:08:44.414370Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.06281447410583496, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.accepted_values_stg_orders_order_status__F__O__P.ab2f441db0", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        order_status as value_field,\n        count(*) as n_records\n\n    from RETAIL_DBT.DEV.stg_orders\n    group by order_status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'F','O','P'\n)\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.372601Z", "completed_at": "2026-11-03T06:08:44.411433Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.416699Z", "completed_at": "2026-11-03T06:08:44.416704Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.06277823448181152, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_stg_orders_order_key.6dbbb0203d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect order_key\nfrom RETAIL_DBT.DEV.stg_orders\nwhere order_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.377380Z", "completed_at": "2026-11-03T06:08:44.412357Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.418063Z", "completed_at": "2026-11-03T06:08:44.418068Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.06356668472290039, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.unique_stg_orders_order_key.93561928ed", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_key as unique_field,\n    count(*) as n_records\n\nfrom RETAIL_DBT.DEV.stg_orders\nwhere order_key is not null\ngroup by order_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.382200Z", "completed_at": "2026-11-03T06:08:44.413669Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.419034Z", "completed_at": "2026-11-03T06:08:44.419040Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.06397724151611328, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.fct_orders", "compiled": true, "compiled_code": "\n\nwith __dbt__cte__int_order_items as (\n-- materialized: ephemeral (from dbt_project.yml). Inlined as a CTE, never created in Snowflake.\nselect\n    order_key,\n    count(*)                                                        as line_count,\n    sum(quantity)                                                   as total_quantity,\n    sum(round(extended_price * (1 - discount), 2))             as net_revenue\nfrom RETAIL_DBT.DEV.stg_lineitems\ngroup by order_key\n) select\n    o.order_key,\n    o.customer_key,\n    o.order_date,\n    o.order_status,\n    s.status_description,\n    o.order_priority,\n    o.total_price,\n    i.line_count,\n    i.total_quantity,\n    i.net_revenue\nfrom RETAIL_DBT.DEV.stg_orders o\nleft join __dbt__cte__int_order_items i\n    on o.order_key = i.order_key\nleft join RETAIL_DBT.DEV.order_status_lookup s\n    on o.order_status = s.status_code\n\n\nwhere o.order_date >= (select max(order_date) from RETAIL_DBT.DEV.fct_orders)\n", "relation_name": "RETAIL_DBT.DEV.fct_orders", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.394048Z", "completed_at": "2026-11-03T06:08:44.415185Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.420044Z", "completed_at": "2026-11-03T06:08:44.420050Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.06335592269897461, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_dim_customers_customer_key.4bebfb3411", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect customer_key\nfrom RETAIL_DBT.DEV.dim_customers\nwhere customer_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.401203Z", "completed_at": "2026-11-03T06:08:44.416067Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.420831Z", "completed_at": "2026-11-03T06:08:44.420836Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.06358075141906738, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_dim_customers_region_manager.3f6d44c3c9", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect region_manager\nfrom RETAIL_DBT.DEV.dim_customers\nwhere region_manager is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.406009Z", "completed_at": "2026-11-03T06:08:44.417532Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.421741Z", "completed_at": "2026-11-03T06:08:44.421747Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.06394147872924805, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.unique_dim_customers_customer_key.ad8156656e", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    customer_key as unique_field,\n    count(*) as n_records\n\nfrom RETAIL_DBT.DEV.dim_customers\nwhere customer_key is not null\ngroup by customer_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.433081Z", "completed_at": "2026-11-03T06:08:44.463290Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.467248Z", "completed_at": "2026-11-03T06:08:44.467255Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.04086875915527344, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.mart_sales_by_region", "compiled": true, "compiled_code": "\n\nselect\n    c.region_name,\n    c.region_manager,\n    year(f.order_date)       as order_year,\n    count(distinct f.order_key)    as orders,\n    count(distinct f.customer_key) as customers,\n    sum(f.net_revenue)       as net_revenue\nfrom RETAIL_DBT.DEV.fct_orders f\njoin RETAIL_DBT.DEV.dim_customers c\n    on f.customer_key = c.customer_key\ngroup by 1, 2, 3", "relation_name": "RETAIL_DBT.DEV.mart_sales_by_region", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.437247Z", "completed_at": "2026-11-03T06:08:44.464139Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.468681Z", "completed_at": "2026-11-03T06:08:44.468687Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.041673898696899414, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.assert_no_negative_revenue", "compiled": true, "compiled_code": "-- Singular test: returns rows that FAIL. Passes when no order has negative revenue.\nselect order_key, net_revenue\nfrom RETAIL_DBT.DEV.fct_orders\nwhere net_revenue < 0", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.441007Z", "completed_at": "2026-11-03T06:08:44.465010Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.469444Z", "completed_at": "2026-11-03T06:08:44.469449Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.04185175895690918, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_fct_orders_customer_key.af098eeeef", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect customer_key\nfrom RETAIL_DBT.DEV.fct_orders\nwhere customer_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.447409Z", "completed_at": "2026-11-03T06:08:44.465733Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.470188Z", "completed_at": "2026-11-03T06:08:44.470192Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.0419769287109375, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_fct_orders_order_key.6a6f83ab15", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect order_key\nfrom RETAIL_DBT.DEV.fct_orders\nwhere order_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.452174Z", "completed_at": "2026-11-03T06:08:44.466578Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.470944Z", "completed_at": "2026-11-03T06:08:44.470949Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.042145490646362305, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.relationships_fct_orders_customer_key__customer_key__ref_dim_customers_.018eb0a60b", "compiled": true, "compiled_code": "\n    \n    \n\nwith child as (\n    select customer_key as from_field\n    from RETAIL_DBT.DEV.fct_orders\n    where customer_key is not null\n),\n\nparent as (\n    select customer_key as to_field\n    from RETAIL_DBT.DEV.dim_customers\n)\n\nselect\n    from_field\n\nfrom child\nleft join parent\n    on child.from_field = parent.to_field\n\nwhere parent.to_field is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.458162Z", "completed_at": "2026-11-03T06:08:44.468166Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.471899Z", "completed_at": "2026-11-03T06:08:44.471905Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.04251861572265625, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.unique_fct_orders_order_key.f5e7a90273", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_key as unique_field,\n    count(*) as n_records\n\nfrom RETAIL_DBT.DEV.fct_orders\nwhere order_key is not null\ngroup by order_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}], "elapsed_time": 1.0158519744873047, "args": {"indirect_selection": "eager", "target": "dev", "quiet": false, "select": [], "inject_ephemeral_ctes": true, "printer_width": 80, "log_level": "info", "exclude": [], "log_path": "/tmp/dbt/logs", "partial_parse": true, "source_freshness_run_project_hooks": false, "static_parser": true, "partial_parse_file_diff": true, "require_yaml_configuration_for_mf_time_spines": false, "invocation_command": "dbt ", "log_format": "default", "log_level_file": "debug", "vars": {}, "send_anonymous_usage_stats": false, "introspect": true, "populate_cache": true, "show_resource_report": false, "project_dir": "/tmp/dbt", "macro_debugging": false, "state_modified_compare_vars": false, "state_modified_compare_more_unrendered_values": false, "skip_nodes_if_on_run_start_fails": false, "print": true, "require_batched_execution_for_custom_microbatch_strategy": false, "strict_mode": false, "use_colors_file": true, "version_check": true, "use_colors": true, "write_json": true, "profiles_dir": "/tmp/dbt_effective_profiles_obgycygc", "which": "compile", "log_format_file": "debug", "log_file_max_bytes": 10485760, "require_explicit_package_overrides_for_builtin_materializations": true, "warn_error_options": {"include": [], "exclude": []}, "cache_selected_only": false, "require_resource_names_without_spaces": false, "favor_state": false, "require_nested_cumulative_ty