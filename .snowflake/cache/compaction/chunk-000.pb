	ADR_FACTOR_AMT,
	ADR_RELAT_SEDOL_ID,
	ADR_RELAT_CUSIP_ID,
	ADR_RELAT_ISIN_ID,
	SHRS_OUTST_AMT,
	TOT_ISS_AMT,
	CONSD_CONST_RT_AMT,
	DEBT_TO_CAP_RT_AMT,
	DEBT_TO_EQTY_RT_AMT,
	DIV_5YR_GROW_RT_AMT,
	PRC_TO_SALE_RT_AMT,
	PRC_TO_CASH_FLOW_RT_AMT,
	PRC_TO_BV_RT_AMT,
