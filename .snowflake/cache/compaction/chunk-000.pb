	MATUR_DATE,
	TOT_SHR_OUTST_AMT,
	AST_SHORT_DESC,
	AST_LONG_DESC,
	MOODY_QUAL_DCDE,
	SP_QUAL_DCDE,
	CALL_PRC_AMT,
	CALL_DATE,
