	ASD_AST_ICL_GICS_ECN_SCTR_DESC,
	ASD_AST_ICL_GICS_IND_GRP_DESC,
	ASD_AST_ICL_GICS_IND_CLSS_DESC,
	ASD_AST_ICL_GICS_SUB_IND_DESC,
	ASD_AST_RTNG_ISS_TYPE,
	ASD_AST_RTNG_MOODY_QUAL_CD,
	ASD_AST_RTNG_MOODY_QUAL_DESC,
	ASD_AST_RTNG_SP_QUAL_CD,
	ASD_AST_RTNG_SP_QUAL_DESC,
	ASD_AST_INC_RT_AMT,
	ASD_LOAN_AC_NUM_ID,
	ASD_LOAN_NUM_ID,
	ASD_LOAN_COMMT_NUM_ID,
	ASD_SRC_SYSTM_KEY,
	ASD_SRC_AS_OF_STAT_CD,
	ASD_ACTV_FRM_DT,
	ASD_ACTV_TO_DT,
	FM_SEC_ID,
	TOT_SHR_OUTST_AMT,
	CALL_PRC_AMT,
	ORIG_ISS_AMT,
	DUR_TO_MATUR_AMT,
	BETA_PRED_RT_AMT,
	BETA_PRED_LCL_RT_AMT,
	BETA_PRED_WRLD_RT_AMT,
	ROR_DV_RT_AMT,
	MKT_CAP_AMT,
	PE_RATIO_AMT,
	EPS_AMT,
	EPS_12_MO_AMT,
	EPS_5YR_GROW_AMT,
	CINS_ID,
	PYDN_FCTR_RT_AMT,
	ROR_MATUR_RT_AMT,
	ADR_FACTOR_AMT,
	ADR_RELAT_SEDOL_ID,
	ADR_RELAT_CUSIP_ID,
	ADR_RELAT_ISIN_ID,
	SHRS_OUTST_AMT,
	TOT_ISS_AMT,
	CONSD_CONST_RT_AMT,
	DEBT_TO_CAP_RT_AMT,
	DEBT_TO_EQTY_RT_AMT,
	DIV_5YR_GROW_RT_AMT,
	PRC_TO_SALE_RT_AMT,
	PRC_TO_CASH_FLOW_RT_AMT,
	PRC_TO_BV_RT_AMT,
	ROE_RT_AMT,
	ROC_RT_AMT,
	ROA_RT_AMT,
	POOL_ID,
	CREAT_BY,
	UPD_BY,
	UPD_TM,
	PCR_AST_ID,
	BKRG_AST_ID,
	MAN_AGGR_AST_ID,
	LOC_COMMT_AMT,
	VINTAGE_YR,
	STRK_PRC_AMT,
	LOC_FUND_AMT,
	YLD_TO_MATUR_AMT,
	YRS_TO_MATUR_AMT,
	PIT_SWEEP_FLAG,
	MMF_NAV_IND
) target_lag = '7 minutes' refresh_mode = INCREMENTAL initialize = ON_CREATE warehouse = DEV_ADHOC_ANALYSIS
 as

WITH INSTR_IDS AS
(
    SELECT INSTR_ID
    FROM DEV_WPA_HOLDINGS_DB.CORE.WPA_AC_POSITION
    WHERE INSTR_ID IS NOT NULL
    UNION
    SELECT INSTR_ID
    FROM DEV_WPA_TRANSACTION_DB.CORE.WPA_PE_TRAN
    WHERE INSTR_ID IS NOT NULL
),

ASSET AS
(
    SELECT A.*
    FROM DEV_WPA_ASSET_DB.CORE.NPF_ASSET A
    INNER JOIN INSTR_IDS I ON I.INSTR_ID = A.INSTR_ID
),

DECODE AS
(
    SELECT *
    FROM DEV_ANALYTICS_DB.WCA.WCA_WPA_MDW_D_DECODE_COLUMNAR
)

SELECT
    ABS(HASH(ASSET.INSTR_ID))                         AS ASD_ASSET_SID,
    ASSET.INSTR_ID                                    AS ASD_INSTR_ID,
    ASSET.CUSIP_ID                                    AS ASD_CUSIP_ID,
    ASSET.TNT_SEC_ID                                  AS ASD_TNT_SEC_ID,
    ASSET.SEDOL_ID                                    AS ASD_SEDOL_ID,
    ASSET.TKR_SYM_ID                                  AS ASD_TKR_SYM_ID,
    ASSET.ISIN_ID                                     AS ASD_ISIN_ID,
    ASSET.ISS_TYPE                                    AS ASD_AST_ISS_TYPE,
    REGEXP_REPLACE(TRIM(COALESCE(ASSET.AST_SHORT_DESC, '')), '\\s+', ' ') AS ASD_AST_AST_SHRT_DESC,
    REGEXP_REPLACE(TRIM(COALESCE(ASSET.AST_LONG_DESC, '')), '\\s+', ' ') AS ASD_AST_AST_LNG_DESC,
    ASSET.ST_INCRP_DCDE                               AS ASD_AST_ST_INCRP_CD,
    D1.STATE_DESC                                     AS ASD_AST_ST_INCRP_DESC,
    ASSET.CNTRY_QUOTE_DCDE                            AS ASD_AST_CNTRY_QUOTE_CD,
    D4.CNTRY_DESC                                     AS ASD_AST_CNTRY_QUOTE_DESC,
    ASSET.CNTRY_RISK_DCDE                             AS ASD_AST_CNTRY_RISK_CD,
    D5.CNTRY_DESC                                     AS ASD_AST_CNTRY_RISK_DESC,
    ASSET.CNTRY_INCRP_DCDE                            AS ASD_AST_CNTRY_INCRP_CD,
    D6.CNTRY_DESC                                     AS ASD_AST_CNTRY_INCRP_DESC,
    TO_DATE(SUBSTR(ASSET.MATUR_DATE, 1, 10))          AS ASD_AST_MATUR_DT,
    TO_DATE(SUBSTR(ASSET.CALL_DATE, 1, 10))           AS ASD_AST_CALL_DT,
    TO_DATE(SUBSTR(ASSET.ORIG_ISS_DATE, 1, 10))       AS ASD_AST_ORIG_ISS_DT,
    ASSET.DENOM_CURR_DCDE                             AS ASD_AST_DENOM_CURR_CD,
    D7.CURR_DESC                                      AS ASD_AST_DENOM_CURR_DESC,
    ASSET.PRC_CURR_DCDE                               AS ASD_AST_PRC_CURR_CD,
    D8.CURR_DESC                                      AS ASD_AST_PRC_CURR_DESC,
    TO_DATE(SUBSTR(ASSET.PYBL_DATE, 1, 10))           AS ASD_AST_PYBL_DT,
    TO_DATE(SUBSTR(ASSET.REC_DATE, 1, 10))            AS ASD_AST_REC_DT,
    TO_DATE(SUBSTR(ASSET.EX_DIV_DATE, 1, 10))         AS ASD_AST_EX_DIV_DT,
    ASSET.MKT_CAP_CURR_DCDE                           AS ASD_AST_MKT_CAP_CURR_CD,
    D9.CURR_DESC                                      AS ASD_AST_MKT_CAP_CURR_DESC,
    ASSET.PVT_PLC_ID                                  AS ASD_AST_PVT_PLC_ID,
    ASSET.ISSR_DESC                                   AS ASD_AST_ISSR_DESC,
    ASSET.PYMT_FREQ_DCDE                              AS ASD_AST_PYMT_FREQ_CD,
    D11.PMTFREQ_DESC                                  AS ASD_AST_PYMT_FREQ_DESC,
    ASSET.EPS_CURR_DCDE                               AS ASD_AST_EPS_CURR_CD,
    D10.CURR_DESC                                     AS ASD_AST_EPS_CURR_DESC,
    ASSET.PRIM_TRD_EXCH_DCDE                          AS ASD_AST_PRIM_TRD_EXCH_CD,
    D16.EXCHANGE_DESC                                 AS ASD_AST_PRIM_TRD_EXCH_DESC,
    ASSET.RTRS_CDE                                    AS ASD_AST_RTRS_CD,
    NULL                                              AS ASD_AST_RTRS_DESC,
    TO_DATE(SUBSTR(ASSET.FRST_CPN_DATE, 1, 10))       AS ASD_AST_FRST_CPN_DT,
    TO_DATE(SUBSTR(ASSET.PRE_REFND_DATE, 1, 10))      AS ASD_AST_PRE_REFND_DT,
    ASSET.ACTV_STAT_TYPE                              AS ASD_AST_ACTV_STAT_TYPE,
    TO_DATE(SUBSTR(ASSET.PRTNR_STMT_DATE, 1, 10)) AS ASD_AST_PRTNR_STMT_DT,
    TO_DATE(SUBSTR(ASSET.PRTNR_VALN_RCVD_DATE, 1, 10)) AS ASD_AST_PRTNR_VALN_RCVD_DT,
    ASSET.FUND_TYPE                                   AS ASD_AST_FUND_TYPE,
    ASSET.MKT_CAP_GRP_DCDE                            AS ASD_AST_MKT_CAP_GRP_CD,
    D17.CURR_DESC                                     AS ASD_AST_MKT_CAP_GRP_DESC,
    ASSET.AMT_ELIG_INDC                               AS ASD_AST_AMT_ELIG_IND,
    CAT.ACX_ISS_TYPE                                  AS ASD_AST_CTGR_ISS_TYPE,
    CAT.ACX_RPTG_TYPE                                 AS ASD_AST_CTGR_RPTG_TYPE,
    NVL(CAT.ACX_SUP_CATG_CD, '30')                    AS ASD_AST_CTGR_SUP_CD,
    NVL(CAT.ACX_SUP_CATG_DESC, 'Other Assets')        AS ASD_AST_CTGR_SUP_DESC,
    NVL(CAT.ACX_SUB_CATG_CD, '20')                    AS ASD_AST_CTGR_SUB_CD,
    NVL(CAT.ACX_SUB_CATG_DESC, 'Miscellaneous')       AS ASD_AST_CTGR_SUB_DESC,
    NULL                                              AS ASD_AST_CTGR_SRT_NBR,
    ASSET.GICS_ECON_SECTR_DCDE                        AS ASD_AST_ICL_GICS_ECN_SCTR_CD,
    ASSET.GICS_IND_GRP_DCDE                           AS ASD_AST_ICL_GICS_IND_GRP_CD,
    ASSET.GICS_IND_CLASS_DCDE                         AS ASD_AST_ICL_GICS_IND_CLSS_CD,
    ASSET.GICS_SUB_IND_DCDE                           AS ASD_AST_ICL_GICS_SUB_IND_CD,
    D12.GICSECTR_DESC                                 AS ASD_AST_ICL_GICS_ECN_SCTR_DESC,
    D13.GICSINDGRP_DESC                               AS ASD_AST_ICL_GICS_IND_GRP_DESC,
    D14.GICSINDCLS_DESC                               AS ASD_AST_ICL_GICS_IND_CLSS_DESC,
    D15.GICSSUBIND_DESC                               AS ASD_AST_ICL_GICS_SUB_IND_DESC,
    NULL                                              AS ASD_AST_RTNG_ISS_TYPE,
    ASSET.MOODY_QUAL_DCDE                             AS ASD_AST_RTNG_MOODY_QUAL_CD,
    D2.MOODY_DESC                                     AS ASD_AST_RTNG_MOODY_QUAL_DESC,
    ASSET.SP_QUAL_DCDE                                AS ASD_AST_RTNG_SP_QUAL_CD,
    D3.SP_DESC                                        AS ASD_AST_RTNG_SP_QUAL_DESC,
    ASSET.INC_RT_AMT                                  AS ASD_AST_INC_RT_AMT,
    NULL                                              AS ASD_LOAN_AC_NUM_ID,
    NULL                                              AS ASD_LOAN_NUM_ID,
    NULL                                              AS ASD_LOAN_COMMT_NUM_ID,
    ASSET.DATA_SRC_ID                                 AS ASD_SRC_SYSTM_KEY,
    'A'                                               AS ASD_SRC_AS_OF_STAT_CD,
    TO_DATE(ASSET.CREAT_TM)                           AS ASD_ACTV_FRM_DT,
    TO_DATE('9999-12-31')                             AS ASD_ACTV_TO_DT,

    ASSET.FM_SEC_ID                                   AS FM_SEC_ID,
    ASSET.TOT_SHR_OUTST_AMT                           AS TOT_SHR_OUTST_AMT,
    ASSET.CALL_PRC_AMT                                AS CALL_PRC_AMT,
    ASSET.ORIG_ISS_AMT                                AS ORIG_ISS_AMT,
    ASSET.DUR_TO_MATUR_AMT                            AS DUR_TO_MATUR_AMT,
    ASSET.BETA_PRED_RT_AMT                            AS BETA_PRED_RT_AMT,
    ASSET.BETA_PRED_LCL_RT_AMT                        AS BETA_PRED_LCL_RT_AMT,
    ASSET.BETA_PRED_WRLD_RT_AMT                       AS BETA_PRED_WRLD_RT_AMT,
    ASSET.ROR_DV_RT_AMT                               AS ROR_DV_RT_AMT,
    ASSET.MKT_CAP_AMT                                 AS MKT_CAP_AMT,
    ASSET.PE_RATIO_AMT                                AS PE_RATIO_AMT,
    ASSET.EPS_AMT                                     AS EPS_AMT,
    ASSET.EPS_12_MO_AMT                               AS EPS_12_MO_AMT,
    ASSET.EPS_5YR_GROW_AMT                            AS EPS_5YR_GROW_AMT,
    ASSET.CINS_ID                                     AS CINS_ID,
    ASSET.PYDN_FCTR_RT_AMT                            AS PYDN_FCTR_RT_AMT,
    ASSET.ROR_MATUR_RT_AMT                            AS ROR_MATUR_RT_AMT,
    ASSET.ADR_FACTOR_AMT                              AS ADR_FACTOR_AMT,
    ASSET.ADR_RELAT_SEDOL_ID                          AS ADR_RELAT_SEDOL_ID,
    ASSET.ADR_RELAT_CUSIP_ID                          AS ADR_RELAT_CUSIP_ID,
    ASSET.ADR_RELAT_ISIN_ID                           AS ADR_RELAT_ISIN_ID,
    ASSET.SHRS_OUTST_AMT                              AS SHRS_OUTST_AMT,
    ASSET.TOT_ISS_AMT                                 AS TOT_ISS_AMT,
    ASSET.CONSD_CONST_RT_AMT                          AS CONSD_CONST_RT_AMT,
    ASSET.DEBT_TO_CAP_RT_AMT                          AS DEBT_TO_CAP_RT_AMT,
    ASSET.DEBT_TO_EQTY_RT_AMT                         AS DEBT_TO_EQTY_RT_AMT,
    ASSET.DIV_5YR_GROW_RT_AMT                         AS DIV_5YR_GROW_RT_AMT,
    ASSET.PRC_TO_SALE_RT_AMT                          AS PRC_TO_SALE_RT_AMT,
    ASSET.PRC_TO_CASH_FLOW_RT_AMT                     AS PRC_TO_CASH_FLOW_RT_AMT,
    ASSET.PRC_TO_BV_RT_AMT                            AS PRC_TO_BV_RT_AMT,
    ASSET.ROE_RT_AMT                                  AS ROE_RT_AMT,
    ASSET.ROC_RT_AMT                                  AS ROC_RT_AMT,
    ASSET.ROA_RT_AMT                                  AS ROA_RT_AMT,
    ASSET.POOL_ID                                     AS POOL_ID,
    ASSET.CREAT_BY                                    AS CREAT_BY,
    ASSET.UPD_BY                                      AS UPD_BY,
    ASSET.UPD_TM                                      AS UPD_TM,
    ASSET.PCR_AST_ID                                  AS PCR_AST_ID,
    ASSET.BKRG_AST_ID                                 AS BKRG_AST_ID,
    ASSET.MAN_AGGR_AST_ID                             AS MAN_AGGR_AST_ID,
    ASSET.LOC_COMMT_AMT                               AS LOC_COMMT_AMT,
    ASSET.VINTAGE_YR                                  AS VINTAGE_YR,
    ASSET.STRK_PRC_AMT                                AS STRK_PRC_AMT,
    ASSET.LOC_FUND_AMT                                AS LOC_FUND_AMT,
    ASSET.YLD_TO_MATUR_AMT                            AS YLD_TO_MATUR_AMT,
    ASSET.YRS_TO_MATUR_AMT                            AS YRS_TO_MATUR_AMT,
    ASSET.PIT_SWEEP_FLAG                              AS PIT_SWEEP_FLAG,
    ASSET.MMF_NAV_IND                                 AS MMF_NAV_IND
FROM ASSET
LEFT JOIN DEV_ANALYTICS_DB.WPA.WCA_WPA_MDW_D_AST_CTG_VW_NPF CAT ON ASSET.ISS_TYPE = CAT.ACX_ISS_TYPE
LEFT JOIN DECODE D1  ON D1.DCDE_CODE  = ASSET.ST_INCRP_DCDE
LEFT JOIN DECODE D2  ON D2.DCDE_CODE  = ASSET.MOODY_QUAL_DCDE
LEFT JOIN DECODE D3  ON D3.DCDE_CODE  = ASSET.SP_QUAL_DCDE
LEFT JOIN DECODE D4  ON D4.DCDE_CODE  = ASSET.CNTRY_QUOTE_DCDE
LEFT JOIN DECODE D5  ON D5.DCDE_CODE  = ASSET.CNTRY_RISK_DCDE
LEFT JOIN DECODE D6  ON D6.DCDE_CODE  = ASSET.CNTRY_INCRP_DCDE
LEFT JOIN DECODE D7  ON D7.DCDE_CODE  = ASSET.DENOM_CURR_DCDE
LEFT JOIN DECODE D8  ON D8.DCDE_CODE  = ASSET.PRC_CURR_DCDE
LEFT JOIN DECODE D9  ON D9.DCDE_CODE  = ASSET.MKT_CAP_CURR_DCDE
LEFT JOIN DECODE D10 ON D10.DCDE_CODE = ASSET.EPS_CURR_DCDE
LEFT JOIN DECODE D11 ON D11.DCDE_CODE = ASSET.PYMT_FREQ_DCDE
LEFT JOIN DECODE D12 ON D12.DCDE_CODE = ASSET.GICS_ECON_SECTR_DCDE
LEFT JOIN DECODE D13 ON D13.DCDE_CODE = ASSET.GICS_IND_GRP_DCDE
LEFT JOIN DECODE D14 ON D14.DCDE_CODE = ASSET.GICS_IND_CLASS_DCDE
LEFT JOIN DECODE D15 ON D15.DCDE_CODE = ASSET.GICS_SUB_IND_DCDE
LEFT JOIN DECODE D16 ON D16.DCDE_CODE = ASSET.PRIM_TRD_EXCH_DCDE
LEFT JOIN DECODE D17 ON D17.DCDE_CODE = ASSET.MKT_CAP_GRP_DCDE;
;


------------------------


create or replace dynamic table PROD_WPA_ASSET_DB.CORE.WPA_ASSET_DYN(
	INSTR_ID,
	ISS_TYPE,
	ISIN_ID,
	CUSIP_ID,
	SEDOL_ID,
	FM_SEC_ID,
	TNT_SEC_ID,
	ST_INCRP_DCDE,
	MATUR_DATE,
	TOT_SHR_OUTST_AMT,
	AST_SHORT_DESC,
	AST_LONG_DESC,
	MOODY_QUAL_DCDE,
	SP_QUAL_DCDE,
	CALL_PRC_AMT,
	CALL_DATE,
	TKR_SYM_ID,
	ORIG_ISS_DATE,
	ORIG_ISS_AMT,
	CNTRY_QUOTE_DCDE,
	CNTRY_RISK_DCDE,
	DENOM_CURR_DCDE,
	PRC_CURR_DCDE,
	INC_RT_AMT,
	DUR_TO_MATUR_AMT,
	PYBL_DATE,
	REC_DATE,
	EX_DIV_DATE,
	BETA_PRED_RT_AMT,
	BETA_PRED_LCL_RT_AMT,
	BETA_PRED_WRLD_RT_AMT,
	ROR_DV_RT_AMT,
	MKT_CAP_AMT,
	MKT_CAP_CURR_DCDE,
	PE_RATIO_AMT,
	EPS_AMT,
	EPS_12_MO_AMT,
	EPS_5YR_GROW_AMT,
	CNTRY_INCRP_DCDE,
	CINS_ID,
	PVT_PLC_ID,
	ISSR_DESC,
	PYMT_FREQ_DCDE,
	PYDN_FCTR_RT_AMT,
	ROR_MATUR_RT_AMT,
	GICS_IND_GRP_DCDE,
	GICS_IND_CLASS_DCDE,
	GICS_SUB_IND_DCDE,
	EPS_CURR_DCDE,
	ADR_FACTOR_AMT,
	ADR_RELAT_SEDOL_ID,
	ADR_RELAT_CUSIP_ID,
	ADR_RELAT_ISIN_ID,
	SHRS_OUTST_AMT,
	TOT_ISS_AMT,
	CONSD_CONST_RT_AMT,
	DEBT_TO_CAP_RT_AMT,
	DEBT_TO_EQTY_RT_AMT,
	DIV_5YR_GROW_RT_AMT,
	PRC_TO_SALE_RT_AMT,
	PRC_TO_CASH_FLOW_RT_AMT,
	PRC_TO_BV_RT_AMT,
	ROE_RT_AMT,
	ROC_RT_AMT,
	ROA_RT_AMT,
	PRIM_TRD_EXCH_DCDE,
	RTRS_CDE,
	POOL_ID,
	FRST_CPN_DATE,
	PRE_REFND_DATE,
	PCR_AST_ID,
	BKRG_AST_ID,
	DATA_SRC_ID,
	MAN_AGGR_AST_ID,
	ACTV_STAT_TYPE,
	PRTNR_STMT_DATE,
	PRTNR_VALN_RCVD_DATE,
	LOC_COMMT_AMT,
	VINTAGE_YR,
	FUND_TYPE,
	STRK_PRC_AMT,
	MKT_CAP_GRP_DCDE,
	LOC_FUND_AMT,
	AMT_ELIG_INDC,
	YLD_TO_MATUR_AMT,
	YRS_TO_MATUR_AMT,
	PIT_SWEEP_FLAG,
	MMF_NAV_IND,
	REGION_RISK_CURR_DESC,
	GICS_ECON_SECTR_DCDE_DESC,
	GICS_IND_CLASS_DCDE_DESC,
	GICS_IND_GRP_DCDE_DESC,
	GICS_SUB_IND_DCDE_DESC,
	CNTRY_RISK_DCDE_DESC,
	CNTRY_INCRP_DCDE_DESC,
	CNTRY_QUOTE_DCDE_DESC,
	DENOM_CURR_DCDE_DESC,
	PYMT_FREQ_DCDE_DESC,
	ST_INCRP_DCDE_DESC,
	AST_SHORT_LONG_DESC_FLG,
	AST_LNG_DESCRIPTION,
	GICS_ECON_SECTR_DCDE,
	MKT_CAP_CURR_DCDE_DESC,
	PRC_CURR_DCDE_DESC,
	EPS_CURR_DCDE_DESC,
	MOODY_QUAL_DCDE_DESC,
	PRIM_TRD_EXCH_DCDE_DESC,
	SP_QUAL_DCDE_DESC
) target_lag = '3 minutes' refresh_mode = INCREMENTAL initialize = ON_SCHEDULE warehouse = PROD_WPA_DYNAMICTABLE_VWH
 as
WITH INSTR_IDS AS (
    SELECT DISTINCT INSTR_ID FROM PROD_WPA_HOLDINGS_DB.CORE.WPA_AC_POSITION
    UNION 
    SELECT DISTINCT INSTR_ID FROM PROD_WPA_TRANSACTION_DB.CORE.WPA_TRANSACTION
)
SELECT
    ast.instr_id,
    ast.iss_type,
    ast.isin_id,
    ast.cusip_id,
    ast.sedol_id,
    ast.fm_sec_id,
    ast.tnt_sec_id,
    ast.st_incrp_dcde,
    ast.matur_date,
    ast.tot_shr_outst_amt,
    ast.ast_short_desc,
    ast.ast_long_desc,
    ast.moody_qual_dcde,
    ast.sp_qual_dcde,
    ast.call_prc_amt,
    ast.call_date,
    ast.tkr_sym_id,
    ast.orig_iss_date,
    ast.orig_iss_amt,
    ast.cntry_quote_dcde,
    ast.cntry_risk_dcde,
    ast.denom_curr_dcde,
    ast.prc_curr_dcde,
    ast.inc_rt_amt,
    ast.dur_to_matur_amt,
    ast.pybl_date,
    ast.rec_date,
    ast.ex_div_date,
    ast.beta_pred_rt_amt,
    ast.beta_pred_lcl_rt_amt,
    ast.beta_pred_wrld_rt_amt,
    ast.ror_dv_rt_amt,
    ast.mkt_cap_amt,
    ast.mkt_cap_curr_dcde,
    ast.pe_ratio_amt,
    ast.eps_amt,
    ast.eps_12_mo_amt,
    ast.eps_5yr_grow_amt,
    ast.cntry_incrp_dcde,
    ast.cins_id,
    ast.pvt_plc_id,
    ast.issr_desc,
    ast.pymt_freq_dcde,
    ast.pydn_fctr_rt_amt,
    ast.ror_matur_rt_amt,
    ast.gics_ind_grp_dcde,
    ast.gics_ind_class_dcde,
    ast.gics_sub_ind_dcde,
    ast.eps_curr_dcde,
    ast.adr_factor_amt,
    ast.adr_relat_sedol_id,
    ast.adr_relat_cusip_id,
    ast.adr_relat_isin_id,
    ast.shrs_outst_amt,
    ast.tot_iss_amt,
    ast.consd_const_rt_amt,
    ast.debt_to_cap_rt_amt,
    ast.debt_to_eqty_rt_amt,
    ast.div_5yr_grow_rt_amt,
    ast.prc_to_sale_rt_amt,
    ast.prc_to_cash_flow_rt_amt,
    ast.prc_to_bv_rt_amt,
    ast.roe_rt_amt,
    ast.roc_rt_amt,
    ast.roa_rt_amt,
    ast.prim_trd_exch_dcde,
    ast.rtrs_cde,
    ast.pool_id,
    ast.frst_cpn_date,
    ast.pre_refnd_date,
    ast.pcr_ast_id,
    ast.bkrg_ast_id,
    ast.data_src_id,
    ast.man_aggr_ast_id,
    ast.actv_stat_type,
    ast.prtnr_stmt_date,
    ast.prtnr_valn_rcvd_date,
    ast.loc_commt_amt,
    ast.vintage_yr,
    ast.fund_type,
    ast.strk_prc_amt,
    ast.mkt_cap_grp_dcde,
    ast.loc_fund_amt,
    ast.amt_elig_indc,
    ast.yld_to_matur_amt,
    ast.yrs_to_matur_amt,
    ast.pit_sweep_flag,
    ast.mmf_nav_ind,
    region.code_desc                              AS region_risk_curr_desc,
    NVL(gise.code_desc, 'Miscellaneous')          AS gics_econ_sectr_dcde_desc,
    NVL(gicls.code_desc, 'Miscellaneous')         AS gics_ind_class_dcde_desc,
    NVL(giind.code_desc, 'Miscellaneous')         AS gics_ind_grp_dcde_desc,
    NVL(gicsub.code_desc, 'Miscellaneous')        AS gics_sub_ind_dcde_desc,
    NVL(cd.code_desc, 'Unknown')                  AS cntry_risk_dcde_desc,
    NVL(incrp.code_desc, 'Unknown')               AS cntry_incrp_dcde_desc,
    NVL(quote.code_desc, 'Unknown')               AS cntry_quote_dcde_desc,
    NVL(curr.code_desc, 'Unknown')                AS denom_curr_dcde_desc,
    pmt.code_desc                                 AS pymt_freq_dcde_desc,
    NVL(st.code_desc, 'Unknown')                  AS st_incrp_dcde_desc,
    CASE
        WHEN ((ast.iss_type IN ('DPSTACK','DPSTCD','DPSTCHK','DPSTICK','DPSTMMD','DPSTSAV') AND ast.data_src_id = 5)
           OR (ast.iss_type IN ('LOANINL','LOANMOL') AND ast.data_src_id = 10))
        THEN 'N'
        ELSE 'Y'
    END                                           AS ast_short_long_desc_flg,
    REGEXP_REPLACE(ast.ast_long_desc, ' ', ' ')   AS ast_lng_description,
    ast.gics_econ_sectr_dcde                      AS gics_econ_sectr_dcde,
    mkt.code_desc                                 AS mkt_cap_curr_dcde_desc,
    lcl.code_desc                                 AS prc_curr_dcde_desc,
    eps.code_desc                                 AS eps_curr_dcde_desc,
    moody.code_desc                               AS moody_qual_dcde_desc,
    ex.code_desc                                  AS prim_trd_exch_dcde_desc,
    sp.code_desc                                  AS sp_qual_dcde_desc
FROM PROD_wpa_asset_db.core.npf_asset ast
JOIN INSTR_IDS I
    ON ast.INSTR_ID = I.INSTR_ID
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw cd
    ON cd.code = ast.cntry_risk_dcde        AND cd.catg     = 'CNTRY'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw quote
    ON quote.code = ast.cntry_quote_dcde    AND quote.catg  = 'CNTRY'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw incrp
    ON incrp.code = ast.cntry_incrp_dcde    AND incrp.catg  = 'CNTRY'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw st
    ON st.code = ast.st_incrp_dcde          AND st.catg     = 'STATE'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw curr
    ON curr.code = ast.denom_curr_dcde      AND curr.catg   = 'CURR'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw mkt
    ON mkt.code = ast.mkt_cap_curr_dcde     AND mkt.catg    = 'CURR'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw lcl
    ON lcl.code = ast.prc_curr_dcde         AND lcl.catg    = 'CURR'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw eps
    ON eps.code = ast.eps_curr_dcde         AND eps.catg    = 'CURR'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw gise
    ON UPPER(TRIM(gise.code::VARCHAR)) = UPPER(TRIM(ast.gics_econ_sectr_dcde::VARCHAR))
   AND gise.catg = 'GICSECTR'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw giind
    ON giind.code = ast.gics_ind_grp_dcde   AND giind.catg  = 'GICSINDGRP'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw gicls
    ON UPPER(TRIM(gicls.code::VARCHAR)) = UPPER(TRIM(ast.gics_ind_class_dcde::VARCHAR))
   AND gicls.catg = 'GICSINDCLS'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw gicsub
    ON gicsub.code = ast.gics_sub_ind_dcde  AND gicsub.catg = 'GICSSUBIND'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw pmt
    ON pmt.code = ast.pymt_freq_dcde        AND pmt.catg    = 'PMTFREQ'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw moody
    ON moody.code = ast.moody_qual_dcde     AND moody.catg  = 'MOODY'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw ex
    ON ex.code = ast.prim_trd_exch_dcde     AND ex.catg     = 'EXCHANGE'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw sp
    ON sp.code = ast.sp_qual_dcde           AND sp.catg     = 'SP'
LEFT JOIN PROD_WPA_REPORT_DB.core.wpa_code_desc_vw region
    ON region.code = ast.cntry_risk_dcde    AND region.catg = 'REGION';

