CSTM Asset schema/Table DDL.sql�&create or replace TABLE NPF_ASSET_CATG (
	SORT_NBR NUMBER(3,0),
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	SUBCATG_CODE VARCHAR(10) NOT NULL,
	SUPCATG_CODE VARCHAR(10) NOT NULL,
	COMNT VARCHAR(150),
	SUPCATG_DESC VARCHAR(254),
	SUBCATG_DESC VARCHAR(254),
	RPTG_TYPE VARCHAR(3) NOT NULL,
	CREAT_BY VARCHAR(30) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	ISS_TYPE VARCHAR(8) NOT NULL,
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (ISS_TYPE, RPTG_TYPE)
);


create or replace TABLE NPF_DECODE (
	DCDE_CODE VARCHAR(20) NOT NULL,
	DCDE_TYPE VARCHAR(31) NOT NULL,
	DCDE_DESC VARCHAR(400) NOT NULL,
	SORT_NBR NUMBER(8,0),
	CREAT_BY VARCHAR(30) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	COMNT VARCHAR(150),
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (DCDE_TYPE, DCDE_CODE)
);

create or replace TABLE NPF_CUST_CSTM_SCHEMA (
	CUST_SK FLOAT NOT NULL,
	SCHEMA_ID FLOAT NOT NULL,
	SCHEMA_DESC VARCHAR(50) NOT NULL,
	SORT_NBR NUMBER(10,0),
	CREAT_BY VARCHAR(30) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (CUST_SK, SCHEMA_ID)
);

create or replace TABLE NPF_CSTM_SCHEMA (
	SCHEMA_ID FLOAT NOT NULL,
	INSTR_ID VARCHAR(11) NOT NULL,
	RPTG_TYPE VARCHAR(3) NOT NULL,
	CSTM_SUPCATG_CODE VARCHAR(10),
	CSTM_SUPCATG_DESC VARCHAR(254),
	NPF_SUPCATG_CODE VARCHAR(10),
	CSTM_SUBCATG_CODE VARCHAR(10),
	CSTM_SUBCATG_DESC VARCHAR(254),
	NPF_SUBCATG_CODE VARCHAR(10),
	CSTM_CNTRY_RISK_DESC VARCHAR(400),
	CSTM_CNTRY_RISK_DCDE VARCHAR(10),
	NPF_CNTRY_RISK_DCDE VARCHAR(10),
	START_DT TIMESTAMP_NTZ(9) NOT NULL,
	CREAT_BY VARCHAR(30) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	END_DT TIMESTAMP_NTZ(9),
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (SCHEMA_ID, INSTR_ID, START_DT, END_DT)
);

create or replace TABLE NPF_CSTM_RULE_MSTR (
	RULE_SK FLOAT NOT NULL,
	SCHEMA_ID FLOAT,
	RULE_NAME VARCHAR(100),
	RULE_CSTM_SUPCATG_CODE VARCHAR(20),
	RULE_CSTM_SUBCATG_CODE VARCHAR(20),
	RULE_CSTM_CNTRY_RISK_DCDE VARCHAR(20),
	RULE_CSTM_SUPCATG_DESC VARCHAR(254),
	RULE_CSTM_SUBCATG_DESC VARCHAR(254),
	RULE_CSTM_CNTRY_RISK_DESC VARCHAR(254),
	CREAT_BY VARCHAR(30) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	RULE_DEL_OPT VARCHAR(10),
	RULE_CRT_OPT VARCHAR(10),
	RULE_STAT VARCHAR(1),
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (RULE_SK)
);


create or replace TABLE NPF_CSTM_RULE_COND (
	COND_SK FLOAT NOT NULL,
	RULE_SK FLOAT NOT NULL,
	RULE_FLD_NAME VARCHAR(100),
	RULE_OPER VARCHAR(10),
	RULE_FLD_CODE VARCHAR(10),
	RULE_FLD_VALUE VARCHAR(254),
	LOGICAL_OPER VARCHAR(10),
	COND_ORDER FLOAT,
	CREAT_BY VARCHAR(30) NOT NULL,
	CREAT_TM TIMESTAMP_NTZ(9) NOT NULL,
	UPD_BY VARCHAR(30) NOT NULL,
	UPD_TM TIMESTAMP_NTZ(9) NOT NULL,
	AUD_TYPE VARCHAR(10),
	AUD_TIME TIMESTAMP_NTZ(9),
	AUD_USER VARCHAR(20),
	AUD_COMMIT_ID NUMBER(38,0),
	AUD_ST_TS TIMESTAMP_NTZ(9) DEFAULT CURRENT_TIMESTAMP(),
	AUD_SEQ_NUM NUMBER(38,0),
	AUD_ACT_STRM BOOLEAN,
	CR_ST_TS TIMESTAMP_NTZ(9),
	UPD_ST_TS TIMESTAMP_NTZ(9),
	primary key (COND_SK, RULE_SK)
);

create or replace TABLE WPA_CSTM_ASSET_SCHEMA_CATG (
	SCHEMA_ID NUMBER(38,0),
	CUST_SK NUMBER(38,0),
	INSTR_ID VARCHAR(16777216),
	RPTG_TYPE VARCHAR(16777216),
	ISS_TYPE VARCHAR(16777216),
	SUPCATG_CODE VARCHAR(16777216),
	SUBCATG_CODE VARCHAR(16777216),
	SUPCATG_DESC VARCHAR(16777216),
	SUBCATG_DESC VARCHAR(16777216),
	CSTM_SUPCATG_CODE VARCHAR(16777216),
	CSTM_SUBCATG_CODE VARCHAR(16777216),
	CSTM_SUPCATG_DESC VARCHAR(16777216),
	CSTM_SUBCATG_DESC VARCHAR(16777216),
	SCHEMA_DESC VARCHAR(16777216),
	UPDATED_AT TIMESTAMP_NTZ(9)
);*
