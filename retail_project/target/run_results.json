cords\n\nfrom RETAIL_DBT.DEV.stg_customers\nwhere customer_key is not null\ngroup by customer_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.330353Z", "completed_at": "2026-11-03T06:08:44.341958Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.348118Z", "completed_at": "2026-11-03T06:08:44.348123Z"}], "thread_id": "Thread-5 (worker)", "execution_time": 0.06378412246704102, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.dim_customers", "compiled": true, "compiled_code": "\n\nselect\n    c.customer_key,\n    c.customer_name,\n    c.market_segment,\n    c.account_balance,\n    n.nation_name,\n    n.region_name,\n    rm.manager_name as region_manager\nfrom RETAIL_DBT.DEV.stg_customers c\nleft join RETAIL_DBT.DEV.stg_nations n\n    on c.nation_key = n.nation_key\nleft join RETAIL_DBT.DEV.region_managers rm\n    on n.region_name = rm.region_name", "relation_name": "RETAIL_DBT.DEV.dim_customers", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.360032Z", "completed_at": "2026-11-03T06:08:44.393272Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.412909Z", "completed_at": "2026-11-03T06:08:44.412915Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.06198835372924805, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.dt_daily_revenue", "compiled": true, "compiled_code": "-- Snowflake dynamic table: Snowflake refreshes it on its own within target_lag.\n-- refresh_mode FULL avoids needing change tracking on the RAW tables (DBT_ROLE doesn't own them).\n\n\nselect\n    order_date,\n    count(*)         as orders,\n    sum(total_price) as gross_revenue\nfrom RETAIL_DBT.DEV.stg_orders\ngroup by order_date", "relation_name": "RETAIL_DBT.DEV.dt_daily_revenue", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.364417Z", "completed_at": "2026-11-03T06:08:44.400685Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.414363Z", "completed_at": "2026-11-03T06:08:44.414370Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.06281447410583496, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.accepted_values_stg_orders_order_status__F__O__P.ab2f441db0", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        order_status as value_field,\n        count(*) as n_records\n\n    from RETAIL_DBT.DEV.stg_orders\n    group by order_status\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'F','O','P'\n)\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.372601Z", "completed_at": "2026-11-03T06:08:44.411433Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.416699Z", "completed_at": "2026-11-03T06:08:44.416704Z"}], "thread_id": "Thread-7 (worker)", "execution_time": 0.06277823448181152, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.not_null_stg_orders_order_key.6dbbb0203d", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect order_key\nfrom RETAIL_DBT.DEV.stg_orders\nwhere order_key is null\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.377380Z", "completed_at": "2026-11-03T06:08:44.412357Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.418063Z", "completed_at": "2026-11-03T06:08:44.418068Z"}], "thread_id": "Thread-8 (worker)", "execution_time": 0.06356668472290039, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.retail_project.unique_stg_orders_order_key.93561928ed", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    order_key as unique_field,\n    count(*) as n_records\n\nfrom RETAIL_DBT.DEV.stg_orders\nwhere order_key is not null\ngroup by order_key\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.382200Z", "completed_at": "2026-11-03T06:08:44.413669Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.419034Z", "completed_at": "2026-11-03T06:08:44.419040Z"}], "thread_id": "Thread-9 (worker)", "execution_time": 0.06397724151611328, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.retail_project.fct_orders", "compiled": true, "compiled_code": "\n\nwith __dbt__cte__int_order_items as (\n-- materialized: ephemeral (from dbt_project.yml). Inlined as a CTE, never created in Snowflake.\nselect\n    order_key,\n    count(*)                                                        as line_count,\n    sum(quantity)                                                   as total_quantity,\n    sum(round(extended_price * (1 - discount), 2))             as net_revenue\nfrom RETAIL_DBT.DEV.stg_lineitems\ngroup by order_key\n) select\n    o.order_key,\n    o.customer_key,\n    o.order_date,\n    o.order_status,\n    s.status_description,\n    o.order_priority,\n    o.total_price,\n    i.line_count,\n    i.total_quantity,\n    i.net_revenue\nfrom RETAIL_DBT.DEV.stg_orders o\nleft join __dbt__cte__int_order_items i\n    on o.order_key = i.order_key\nleft join RETAIL_DBT.DEV.order_status_lookup s\n    on o.order_status = s.status_code\n\n\nwhere o.order_date >= (select max(order_date) from RETAIL_DBT.DEV.fct_orders)\n", "relation_name": "RETAIL_DBT.DEV.fct_orders", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-03T06:08:44.394048Z", "completed_at": "2026-11-03T06:08:44.415185Z"}, {"name": "execute", "started_at": "2026-11-03T06:08:44.420044Z", "completed_at": "2026-11-0