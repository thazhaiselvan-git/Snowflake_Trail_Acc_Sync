    count(*)                                                        as line_count,
    sum(quantity)                                                   as total_quantity,
    sum(round(extended_price * (1 - discount), 2))             as net_revenue
from RETAIL_DBT.DEV.stg_lineitems
group by order_key
) select
    o.order_key,
    o.customer_key,
    o.order_date,
    o.order_status,
