create or replace transient table RETAIL_DBT.DEV.mart_sales_by_region
         as
        (

select
    c.region_name,
    c.region_manager,
    year(f.order_date)       as order_year,
    count(distinct f.order_key)    as orders,
    count(distinct f.customer_key) as customers,
